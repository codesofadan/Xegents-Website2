# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=

# /admin login + cookie/download-link signing secret (any long random string)
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SECRET=

# SMTP for nodemailer (Gmail: smtp.gmail.com / 587 / app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Xegents <zain@xegents.com>
# Internal new-lead notifications go here:
NOTIFY_EMAIL=zen@theredagents.com

# Stripe (optional — card checkout hidden until set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Bank transfer details shown to buyers (use " | " between lines)
BANK_TRANSFER_DETAILS=

# Cloudinary (lead magnet file storage — dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL (used in emails + Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://xegents.com
